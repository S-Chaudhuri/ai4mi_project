    ax.set_ylabel("Hounsfield units")
    ax.axhline(0, lw=0.6, color="0.5")
    ax.grid(alpha=0.25, axis="y")
    ax.legend(fontsize=8)
    finish(fig, "2_intensity_global.png",
           "Whole-volume HU per patient - a shifted patient argues for a fixed window")

    
    fig, ax = plt.subplots(1, 2, figsize=(11, 4.4))
    rng = np.random.default_rng(0)
    for i, name in enumerate(names):
        for panel, key in ((ax[0], f"{name}_ml"), (ax[1], f"{name}_hu_mean")):
            data = [(r["patient"], r[key]) for r in labelled if r.get(key)]
            if not data:
                continue
            xs = i + rng.uniform(-0.12, 0.12, len(data))
            panel.scatter(xs, [v for _, v in data], s=22, alpha=0.75)
            for x, (pid, value) in zip(xs, data):
                mark(panel, x, value, pid)
    if any(r.get(f"{n}_ml", 0) for n in names for r in labelled):
        ax[0].set_yscale("log")
    ax[0].set_ylabel("volume (mL, log scale)")
    ax[1].set_ylabel("mean HU inside the mask")
    ax[1].axhline(0, lw=0.6, color="0.5")
    for a in ax:
        a.set_xticks(range(len(names)))
        a.set_xticklabels(names, rotation=20)
        a.grid(alpha=0.25, axis="y")
    finish(fig, "3_class_volume_and_hu.png", "Per-class size and tissue intensity")

    
    with_percentiles = [n for n in names if any(f"{n}_hu_p50" in r for r in labelled)]
    if with_percentiles:
        fig, ax = plt.subplots(1, len(with_percentiles),
                               figsize=(4.3 * len(with_percentiles), 4), squeeze=False)
        for a, name in zip(ax[0], with_percentiles):
            subset = [r for r in labelled if f"{name}_hu_p50" in r]
            x = range(len(subset))
            a.vlines(x, [r[f"{name}_hu_p05"] for r in subset],
                     [r[f"{name}_hu_p95"] for r in subset], lw=3, alpha=0.3)
            a.vlines(x, [r[f"{name}_hu_p25"] for r in subset],
                     [r[f"{name}_hu_p75"] for r in subset], lw=6)
            a.scatter(x, [r[f"{name}_hu_p50"] for r in subset], s=14, color="k", zorder=3)
            a.set_xticks(list(x))
            a.set_xticklabels([r["patient"].replace("Patient_", "") for r in subset],
                              rotation=90, fontsize=6)
            a.set_title(name)
            a.set_ylabel("HU")
            a.grid(alpha=0.25, axis="y")
        finish(fig, "4_class_hu_spread.png",
               "HU inside each organ - two clusters means contrast versus non-contrast scans")

    
    fig, ax = plt.subplots(figsize=(11, 0.4 * len(labelled) + 2.2))
    for i, r in enumerate(labelled):
        ax.barh(i, r["shape_z"], color="0.92", height=0.82)
        span = 0.66
        step = span / max(len(names), 1)
        for c, name in enumerate(names):
            if f"{name}_z_min" not in r:
                continue
            z0, z1 = r[f"{name}_z_min"], r[f"{name}_z_max"]
            offset = (c - (len(names) - 1) / 2) * step
            ax.barh(i + offset, z1 - z0, left=z0, height=step * 0.8,
                    color=palette[c], label=name if i == 0 else None)
    ax.set_yticks(range(len(labelled)))
    ax.set_yticklabels(short, fontsize=7)
    ax.set_xlabel("slice index   (grey bar is the full scan)")
    ax.invert_yaxis()
    ax.legend(fontsize=8, ncol=max(1, len(names)))
    ax.grid(alpha=0.25, axis="x")
    finish(fig, "5_organ_extent.png",
           "Labelled extent along the body - short bars mean truncated ground truth")

    
    landmark = next((r.get("landmark") for r in labelled if r.get("landmark")), None)
    relative = [n for n in names if n != landmark and any(f"{n}_rel_x" in r for r in labelled)]
    if relative:
        fig, ax = plt.subplots(1, len(relative), figsize=(4.4 * len(relative), 4.2), squeeze=False)
        for a, name in zip(ax[0], relative):
            subset = [r for r in labelled if f"{name}_rel_x" in r]
            xs = [r[f"{name}_rel_x"] for r in subset]
            ys = [r[f"{name}_rel_y"] for r in subset]
            a.scatter(xs, ys, s=24, alpha=0.8)
            for x, y, r in zip(xs, ys, subset):
                mark(a, x, y, r["patient"])
            a.set_title(f"{name} relative to {landmark}")
            a.set_xlabel("x offset (mm)")
            a.set_ylabel("y offset (mm)")
            a.grid(alpha=0.25)
        finish(fig, "6_relative_position.png",
               "Organ offsets from a landmark - only flagged patients are circled")

    # --- 7. one labelled slice per patient ----------------------------------
    if previews:
        columns = min(5, len(previews))
        rows_n = int(np.ceil(len(previews) / columns))
        fig, ax = plt.subplots(rows_n, columns,
                               figsize=(2.5 * columns, 2.6 * rows_n), squeeze=False)
        for a in ax.ravel():
            a.axis("off")
        for i, (pid, (ct_slice, gt_slice)) in enumerate(sorted(previews.items())):
            a = ax[i // columns][i % columns]
            a.imshow(np.rot90(ct_slice), cmap="gray", vmin=-1000, vmax=300)
            for c, label in enumerate(class_names):
                mask = np.rot90(gt_slice) == label
                if mask.any():
                    a.contour(mask.astype(float), levels=[0.5],
                              colors=[palette[c]], linewidths=0.8)
            a.set_title(pid.replace("Patient_", "P"), fontsize=8,
                        color="crimson" if pid in flagged else "black")
        handles = [plt.Line2D([], [], color=palette[c], lw=1.5, label=name)
                   for c, name in enumerate(class_names.values())]
        fig.legend(handles=handles, loc="lower center", ncol=len(handles), fontsize=8,
                   frameon=False, bbox_to_anchor=(0.5, -0.01))
        finish(fig, "7_slice_overview.png",
               "Busiest labelled slice per patient - the eyeball check")

    print(f"[i] {len(written)} figures in {out_dir}: {', '.join(written)}")



def fix_label_affines(patients: list[tuple[str, Path, Path | None]], dest: Path) -> None:

    dest.mkdir(parents=True, exist_ok=True)
    written = 0
    for pid, ct_path, gt_path in patients:
        if gt_path is None:
            continue
        ct_img = nib.load(str(ct_path))
        gt_img = nib.load(str(gt_path))
        data = np.asanyarray(gt_img.dataobj)
        if data.shape != ct_img.shape[:3]:
            print(f"  {Y}skipped{Z} {pid}: label shape {data.shape} != CT {ct_img.shape[:3]}")
            continue
        header = ct_img.header.copy()
        header.set_data_dtype(gt_img.get_data_dtype())
        folder = dest / pid
        folder.mkdir(exist_ok=True)
        nib.save(nib.Nifti1Image(data, ct_img.affine, header), folder / gt_path.name)
        written += 1
    print(f"[i] wrote {written} corrected label file(s) under {dest}")


def write_outputs(rows: list[dict], summary: dict, out_dir: Path) -> None:
    out_dir.mkdir(parents=True, exist_ok=True)
    fields: list[str] = []
    for row in rows:
        for key in row:
            if key not in fields:
                fields.append(key)
    with (out_dir / "profile.csv").open("w", newline="") as fh:
        writer = csv.DictWriter(fh, fieldnames=fields)
        writer.writeheader()
        writer.writerows(rows)
    with (out_dir / "profile.json").open("w") as fh:
        json.dump({"summary": summary, "patients": rows}, fh, indent=2, default=str)
    print(f"\n[i] wrote {out_dir / 'profile.csv'} and {out_dir / 'profile.json'}")


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--zip", type=Path, help="the course zip, e.g. data/segthor_part1.zip")
    source.add_argument("--data-dir", type=Path, help="a folder of Patient_XX directories")
    parser.add_argument("--out", type=Path, default=Path("segthor_profile"))
    parser.add_argument("--classes", type=str, default=None,
                        help='name the labels yourself, e.g. "1=aorta,2=heart,3=trachea"')
    parser.add_argument("--gt-name", type=str, default="GT.nii.gz",
                        help="which label file to profile when a folder holds several, "
                             "e.g. GT2.nii.gz")
    parser.add_argument("--limit", type=int, default=0, help="only profile the first N patients")
    parser.add_argument("--plots", action="store_true", help="also write figures")
    parser.add_argument("--fix-affine", type=Path, default=None, metavar="DIR",
                        help="write copies of the label files carrying the CT geometry")
    args = parser.parse_args()

    if ndimage is None:
        print(f"{Y}[!]{Z} scipy missing, skipping connected-component checks")

    root = resolve_input(args.zip, args.data_dir)
    patients, extra_labels = find_patients(root, args.gt_name)
    if not patients:
        sys.exit(f"no .nii.gz volumes found under {root}")
    if args.limit:
        patients = patients[: args.limit]
    print(f"[i] found {len(patients)} patients under {root}, profiling {args.gt_name}")
    if extra_labels:
        print(f"{Y}[!]{Z} {len(extra_labels)} patient(s) carry more than one label file:")
        for pid, paths in sorted(extra_labels.items()):
            print(f"      {pid}: also {', '.join(p.name for p in paths)}")

    override = parse_class_override(args.classes) if args.classes else None
    class_names = decide_class_names(scan_label_values(patients), override)

    rows: list[dict] = []
    previews: dict = {}
    for i, (pid, ct_path, gt_path) in enumerate(patients, 1):
        print(f"  [{i:>3}/{len(patients)}] {pid}", flush=True)
        try:
            row, preview = profile_patient(pid, ct_path, gt_path, class_names, args.plots)
            rows.append(row)
            if preview is not None:
                previews[pid] = preview
        except Exception as exc:
            print(f"      {R}failed{Z}: {exc}")
            rows.append({"patient": pid, "error": str(exc)})

    usable = [r for r in rows if "error" not in r]
    labelled = [r for r in usable if r.get("has_gt")]
    summary: dict = {
        "n_patients": len(rows),
        "n_labelled": len(labelled),
        "class_names": {str(k): v for k, v in class_names.items()},
    }
    if usable:
        report_geometry(usable, summary)
    flags: list[str] = []
    if labelled:
        report_classes(labelled, class_names, summary)
        flags = report_flags(labelled, class_names, summary)

    if extra_labels:
        banner("LABEL FILES COMPARED")
        comparisons = {}
        by_id = {pid: gt for pid, _, gt in patients}
        for pid, others in sorted(extra_labels.items()):
            primary = by_id.get(pid)
            if primary is not None:
                comparisons[pid] = compare_label_files(pid, primary, others)
        summary["label_file_comparison"] = comparisons

    write_outputs(rows, summary, args.out)
    if args.fix_affine:
        banner("CORRECTED LABEL FILES")
        fix_label_affines(patients, args.fix_affine)
    if args.plots:
        make_figures(rows, previews, class_names, flagged_patients(flags), args.out)
    return 1 if flags else 0


if __name__ == "__main__":
    sys.exit(main())