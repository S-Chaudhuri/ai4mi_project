#!/bin/bash
#SBATCH --job-name=segthor_boxes_dice
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=logs/%j/out.log

# Second 50-epoch 3D boxes-only run (132x132x128 crops) on SEGTHOR_aug,
# dice_ce loss. Companion to jobs/boxes.job (ce).
# wandb: SEGTHOR-UNet3D (the default project).
# Submit from the project root: sbatch jobs/boxes_dice.job
export PATH="$HOME/.local/bin:$PATH"

uv run python -O /home/scur0088/project/src/train.py \
    --config /home/scur0088/project/configs/boxes_dice.yaml \
    --paths.dest /home/scur0088/project/results/segthor_boxes_dice_%j
