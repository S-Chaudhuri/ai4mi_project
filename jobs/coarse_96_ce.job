#!/bin/bash
#SBATCH --job-name=coarse_96_ce
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --time=04:00:00
#SBATCH --output=logs/%j/out.log

# Coarse location-prior run 3/5: 96^3, ce.
# wandb: SEGTHOR-UNet3D-coarse.
# Submit from the project root: sbatch jobs/coarse_96_ce.job
export PATH="$HOME/.local/bin:$PATH"

uv run python -O /home/scur0088/project/src/train.py \
    --config /home/scur0088/project/configs/coarse_96_ce.yaml \
    --paths.dest /home/scur0088/project/results/coarse_96_ce_%j
