#!/bin/bash
#SBATCH --job-name=segthor_3d
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=18
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x/%j/out.log
#SBATCH --constraint=scratch-node

# 3D training + evaluation on the .npy datasets (configs/3d.yaml).
#
#   sbatch -J <name> jobs/3d_npy.job <UNet3D|VNet3D|ResUNet3D|MedNeXt3D> [extra train.py options]
#
# Settings (environment, pass with --export=ALL,NAME=value,...):
#   CHANNELS=1|3          input channels / dataset (default 1)
#   LOSS=dice_ce|ce|tversky                    (default dice_ce)
#   SKIP_AUGMENTED=True   original patients only, no offline-augmented copies
#   DEEP_SUPERVISION=True
#   SKELETON_WEIGHT=<w>   Skeleton Recall loss on top of LOSS (default 0 = off)
#
# Easier: bash jobs/submit_runs.sh (submits the experiments with the right settings)
# MedNeXt3D: add --training.batch_size 4 (batch 8 does not fit a 40 GB A100).

set -euo pipefail

is_true() { [[ "${1,,}" == "true" || "$1" == "1" ]]; }

MODEL=${1:-}
case "$MODEL" in
  UNet3D|VNet3D|ResUNet3D|MedNeXt3D) shift ;;
  *) echo "ERROR: first argument must be the model (UNet3D, VNet3D, ResUNet3D, MedNeXt3D), got '$MODEL'" >&2; exit 2 ;;
esac

CHANNELS=${CHANNELS:-1}
case "$CHANNELS" in 1|3) ;; *) echo "ERROR: CHANNELS must be 1 or 3, got '$CHANNELS'" >&2; exit 2 ;; esac
LOSS=${LOSS:-dice_ce}
case "$LOSS" in ce|dice_ce|tversky) ;; *) echo "ERROR: LOSS must be ce, dice_ce or tversky, got '$LOSS'" >&2; exit 2 ;; esac
SKELETON_WEIGHT=${SKELETON_WEIGHT:-0}
[[ "$SKELETON_WEIGHT" =~ ^[0-9]*\.?[0-9]+$ ]] || { echo "ERROR: SKELETON_WEIGHT must be a number, got '$SKELETON_WEIGHT'" >&2; exit 2; }

DATASET=SEGTHOR_3D_${CHANNELS}ch
PROJECT=${PROJECT:-/home/scur0088/project}
TARS=${TARS:-/scratch-shared/scur0088/tars}

for t in "$TARS/$DATASET.tar" "$TARS/segthor_train_full.tar"; do
  [[ -f "$t" ]] || { echo "ERROR: missing $t" >&2; exit 2; }
done
tar -xf "$TARS/$DATASET.tar" -C "$TMPDIR"
tar -xf "$TARS/segthor_train_full.tar" -C "$TMPDIR"

ARGS=(--training.skeleton_weight "$SKELETON_WEIGHT")
if is_true "${DEEP_SUPERVISION:-False}"; then ARGS+=(--model.deep_supervision); fi
if is_true "${SKIP_AUGMENTED:-False}"; then ARGS+=(--dataset.skip_augmented); fi

echo ">> model=$MODEL channels=$CHANNELS loss=$LOSS skeleton_weight=$SKELETON_WEIGHT" \
     "deep_supervision=${DEEP_SUPERVISION:-False} skip_augmented=${SKIP_AUGMENTED:-False} extra: $*"

export PATH="$HOME/.local/bin:$PATH"
cd "$PROJECT"

# Run python with -O to turn off asserts
uv run python -O src/train.py \
  --config configs/3d.yaml \
  --paths.data_path "$TMPDIR" \
  --dataset.name "$DATASET" \
  --model.in_channels "$CHANNELS" \
  --model.name "$MODEL" \
  --model.is_3d \
  --dataset.box_size 132 132 128 \
  --dataset.fg_prob 0.7 \
  --training.loss "$LOSS" \
  "${ARGS[@]}" \
  "$@"
